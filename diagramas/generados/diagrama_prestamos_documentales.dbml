Table documentos_proceso {
  Note: '''
Proceso organizacional que pertenece a un macroproceso'''

  id big_auto [pk, unique, not null]
  numero integer [note: '''Número del proceso''', not null]
  nombre char [note: '''Nombre del proceso''', not null]
  sigla char [note: '''Sigla del proceso (ej: DIR, THS, SIG)''', not null]
  macroproceso_id foreign_key [not null]

  indexes {
    (macroproceso_id) [name: 'documentos_proceso_macroproceso_id_aba1b422', type: btree]
    (numero,macroproceso_id) [unique, name: 'documentos_proceso_numero_macroproceso_id_7c4d3e85_uniq', type: btree]
    (id) [pk, unique, name: 'documentos_proceso_pkey', type: btree]
  }
}
ref: documentos_proceso.macroproceso_id > documentos_macroproceso.id


Table documentos_registrodearchivo {
  Note: '''
RegistroDeArchivo(id, Estado_archivo, numero_orden, codigo, codigo_serie, codigo_subserie, unidad_documental, fecha_archivo, fecha_inicial, fecha_final, soporte_fisico, soporte_electronico, caja, carpeta, tomo_legajo_libro, numero_folios, tipo, cantidad, ubicacion, cantidad_documentos_electronicos, tamano_documentos_electronicos, identificador_documento, notas, creado_por, fecha_creacion, fecha_edicion, editado_por)'''

  id big_auto [pk, unique, not null]
  Estado_archivo boolean [default:`True`, not null]
  numero_orden integer [default:`0`, not null]
  codigo char [null]
  codigo_serie_id foreign_key [not null]
  codigo_subserie_id foreign_key [null]
  unidad_documental char [not null]
  fecha_archivo date [null]
  fecha_inicial date [null]
  fecha_final date [null]
  soporte_fisico boolean [default:`False`, not null]
  soporte_electronico boolean [default:`False`, not null]
  caja integer [null]
  carpeta integer [null]
  tomo_legajo_libro char [null]
  numero_folios integer [null]
  tipo char [null]
  cantidad integer [null]
  ubicacion char [null]
  cantidad_documentos_electronicos integer [null]
  tamano_documentos_electronicos char [null]
  identificador_documento char [null]
  notas text [null]
  creado_por_id foreign_key [null]
  fecha_creacion date_time [not null]
  fecha_edicion date_time [null]
  editado_por_id foreign_key [note: '''Último usuario que editó este registro''', null]

  indexes {
    (codigo_serie_id) [name: 'documentos_registrodearchivo_codigo_serie_id_ce15f1f1', type: btree]
    (codigo_subserie_id) [name: 'documentos_registrodearchivo_codigo_subserie_id_659f2d27', type: btree]
    (creado_por_id) [name: 'documentos_registrodearchivo_creado_por_id_6e21ec41', type: btree]
    (editado_por_id) [name: 'documentos_registrodearchivo_editado_por_id_e57381df', type: btree]
    (id) [pk, unique, name: 'documentos_registrodearchivo_pkey', type: btree]
  }
}
