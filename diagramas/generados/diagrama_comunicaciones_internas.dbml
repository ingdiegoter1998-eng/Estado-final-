Table auth_group {
  Note: '''
Groups are a generic way of categorizing users to apply permissions, or
some other label, to those users. A user can belong to any number of
groups.

A user in a group automatically has all the permissions granted to that
group. For example, if the group 'Site editors' has the permission
can_edit_home_page, any user in that group will have that permission.

Beyond permissions, groups are a convenient way to categorize users to
apply some label, or extended functionality, to them. For example, you
could create a group 'Special users', and you could write code that would
do special things to those users -- such as giving them access to a
members-only portion of your site, or sending them members-only email
messages.'''

  id auto [pk, unique, not null]
  name char [unique, not null]

  indexes {
    (name) [unique, name: 'auth_group_name_key', type: btree]
    (id) [pk, unique, name: 'auth_group_pkey', type: btree]
  }
}


Table auth_permission {
  Note: '''
The permissions system provides a way to assign permissions to specific
users and groups of users.

The permission system is used by the Django admin site, but may also be
useful in your own code. The Django admin site uses permissions as follows:

- The "add" permission limits the user's ability to view the "add" form
and add an object.
- The "change" permission limits a user's ability to view the change
list, view the "change" form and change an object.
- The "delete" permission limits the ability to delete an object.
- The "view" permission limits the ability to view an object.

Permissions are set globally per type of object, not per specific object
instance. It is possible to say "Mary may change news stories," but it's
not currently possible to say "Mary may change news stories, but only the
ones she created herself" or "Mary may only change news stories that have a
certain status or publication date."

The permissions listed above are automatically created for each model.'''

  id auto [pk, unique, not null]
  name char [not null]
  content_type_id foreign_key [not null]
  codename char [not null]

  indexes {
    (content_type_id) [name: 'auth_permission_content_type_id_2f476e4b', type: btree]
    (content_type_id,codename) [unique, name: 'auth_permission_content_type_id_codename_01ab375a_uniq', type: btree]
    (id) [pk, unique, name: 'auth_permission_pkey', type: btree]
  }
}
ref: auth_permission.content_type_id > django_content_type.id


Table auth_user {
  Note: '''
Users within the Django authentication system are represented by this
model.

Username and password are required. Other fields are optional.'''

  id auto [pk, unique, not null]
  password char [not null]
  last_login date_time [null]
  is_superuser boolean [note: '''Indica que este usuario tiene todos los permisos sin asignárselos explícitamente.''', default:`False`, not null]
  username char [note: '''Requerido. 150 carácteres como máximo. Únicamente letras, dígitos y @/./+/-/_ ''', unique, not null]
  first_name char [not null]
  last_name char [not null]
  email email [not null]
  is_staff boolean [note: '''Indica si el usuario puede entrar en este sitio de administración.''', default:`False`, not null]
  is_active boolean [note: '''Indica si el usuario debe ser tratado como activo. Desmarque esta opción en lugar de borrar la cuenta.''', default:`True`, not null]
  date_joined date_time [default:`django.utils.timezone.now()`, not null]

  indexes {
    (id) [pk, unique, name: 'auth_user_pkey', type: btree]
    (username) [unique, name: 'auth_user_username_key', type: btree]
  }
}


Table correspondencia_anexocomunicacioninterna {
  Note: '''
Modelo para almacenar anexos adjuntos a comunicaciones internas.
Permite adjuntar archivos Word, PDF o Excel.
Límite: 10 anexos por comunicación, 25MB por archivo, 25MB total.'''

  id big_auto [pk, unique, not null]
  comunicacion_id foreign_key [note: '''Comunicación interna a la que pertenece este anexo''', not null]
  archivo file [note: '''Archivo anexo (PDF, Word o Excel)''', not null]
  nombre_original char [note: '''Nombre original del archivo''', not null]
  fecha_carga date_time [note: '''Fecha y hora en que se subió el archivo''', not null]
  subido_por_id foreign_key [note: '''Usuario que subió el anexo''', null]

  indexes {
    (comunicacion_id,fecha_carga) [name: 'corresponde_comunic_9c756c_idx', type: btree]
    (comunicacion_id) [name: 'correspondencia_anexocomunicacioninterna_comunicacion_id_ffebf3ff', type: btree]
    (id) [pk, unique, name: 'correspondencia_anexocomunicacioninterna_pkey', type: btree]
    (subido_por_id) [name: 'correspondencia_anexocomunicacioninterna_subido_por_id_9caeda1b', type: btree]
  }
}
ref: correspondencia_anexocomunicacioninterna.comunicacion_id > correspondencia_comunicacioninterna.id
ref: correspondencia_anexocomunicacioninterna.subido_por_id > auth_user.id


Table correspondencia_comunicacioninterna {
  Note: '''
Modelo para gestionar las comunicaciones internas (Oficios) entre oficinas.
Genera un documento Word basado en plantilla.

Flujo de estados:
- BORRADOR: Usuario puede editar.
- PENDIENTE_APROBACION: Esperando aprobación del líder.
- RECHAZADA: Líder rechazó. Fin del flujo.
- APROBADA: Líder aprobó. Si es a toda la entidad, requiere firma antes de distribuir.
- DISTRIBUIDA: Comunicación enviada a destinatarios.
- RESPONDIDA: Se creó una respuesta a esta comunicación.'''

  id big_auto [pk, unique, not null]
  radicado char [unique, null]
  codigo_dependencia char [note: '''Código jerárquico de la dependencia/oficina productora''', null]
  anio_radicado positive_small_integer [null]
  consecutivo_radicado positive_integer [null]
  serie_documental_id foreign_key [note: '''Serie documental asociada a la comunicación interna''', null]
  subserie_documental_id foreign_key [note: '''Subserie documental asociada a la comunicación interna''', null]
  trd char [note: '''Código TRD (Tabla de Retención Documental)''', null]
  fecha_creacion date_time [not null]
  ciudad char [default:`"Saravena"`, not null]
  fecha_documento date [note: '''Fecha que aparecerá en el documento impreso''', not null]
  tipo_distribucion correspondencia.char_comunicacioninterna_tipo_distribucion [note: '''Tipo de distribución de la comunicación''', default:`"USUARIO"`, null]
  es_a_toda_entidad boolean [note: '''Si es True, va a todos los usuarios del sistema y requiere firma digital. (DEPRECADO: usar tipo_distribucion="ENTIDAD")''', default:`False`, not null]
  remitente_usuario_id foreign_key [not null]
  remitente_nombre char [not null]
  remitente_cargo char [null]
  remitente_oficina_id foreign_key [not null]
  destinatario_oficina_id foreign_key [note: '''Oficina destino. Dejar vacío si es a toda la entidad.''', null]
  destinatario_usuario_id foreign_key [note: '''Opcional: Si va dirigido a una persona específica''', null]
  destinatario_proceso_id foreign_key [note: '''Proceso destino (solo cuando tipo_distribucion = "PROCESO")''', null]
  asunto char [not null]
  cuerpo text [note: '''Contenido principal de la comunicación''', not null]
  archivo_generado file [null]
  archivo_firmado file [note: '''PDF firmado digitalmente por el líder (requerido para distribución a oficina/proceso/entidad)''', null]
  fecha_firma date_time [note: '''Fecha y hora en que se subió el archivo firmado''', null]
  revisado_por_id foreign_key [note: '''Líder de oficina que revisó y aprobó la comunicación''', null]
  revisado_nombre char [note: '''Nombre del revisor (snapshot)''', null]
  revisado_cargo char [note: '''Cargo del revisor (snapshot)''', null]
  fecha_revision date_time [note: '''Fecha y hora de revisión/aprobación''', null]
  motivo_rechazo text [note: '''Motivo del rechazo (si aplica)''', null]
  comunicacion_origen_id foreign_key [note: '''Comunicación original a la que responde (múltiples respuestas permitidas)''', null]
  es_respuesta_destacada boolean [note: '''Indica si esta respuesta está destacada (estrellita). Líderes y usuarios asignados inicialmente tienen respuestas destacadas.''', default:`False`, not null]
  fecha_distribucion date_time [note: '''Fecha y hora de distribución''', null]
  estado correspondencia.char_comunicacioninterna_estado [default:`"BORRADOR"`, not null]

  indexes {
    (comunicacion_origen_id) [name: 'correspondencia_comunicacioninterna_comunicacion_origen_id_aa179bcb', type: btree]
    (destinatario_oficina_id) [name: 'correspondencia_comunicacioninterna_destinatario_oficina_id_a9729f2a', type: btree]
    (destinatario_proceso_id) [name: 'correspondencia_comunicacioninterna_destinatario_proceso_id_0fc7fcea', type: btree]
    (destinatario_usuario_id) [name: 'correspondencia_comunicacioninterna_destinatario_usuario_id_76c0596c', type: btree]
    (id) [pk, unique, name: 'correspondencia_comunicacioninterna_pkey', type: btree]
    (radicado) [unique, name: 'correspondencia_comunicacioninterna_radicado_key', type: btree]
    (remitente_oficina_id) [name: 'correspondencia_comunicacioninterna_remitente_oficina_id_235f04fd', type: btree]
    (remitente_usuario_id) [name: 'correspondencia_comunicacioninterna_remitente_usuario_id_d29c0f24', type: btree]
    (revisado_por_id) [name: 'correspondencia_comunicacioninterna_revisado_por_id_bd9d7cea', type: btree]
    (serie_documental_id) [name: 'correspondencia_comunicacioninterna_serie_documental_id_f5c71249', type: btree]
    (subserie_documental_id) [name: 'correspondencia_comunicacioninterna_subserie_documental_id_7039d29b', type: btree]
  }
}
ref: correspondencia_comunicacioninterna.serie_documental_id > documentos_seriedocumental.id
ref: correspondencia_comunicacioninterna.subserie_documental_id > documentos_subseriedocumental.id
ref: correspondencia_comunicacioninterna.remitente_usuario_id > auth_user.id
