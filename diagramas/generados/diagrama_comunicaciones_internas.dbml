Project "Comunicaciones Internas" {
  database_type: 'Microsoft SQL'
  Note: '''Oficios entre dependencias (radicado, destinatarios, anexos, historial)
  Last Updated At 06-22-2026 04:24AM UTC'''
}

enum correspondencia.char_comunicacioninterna_estado {
  "BORRADOR" [note: '''Borrador''']
  "PENDIENTE_APROBACION" [note: '''Pendiente de Aprobación''']
  "RECHAZADA" [note: '''Rechazada''']
  "APROBADA" [note: '''Aprobada (Pendiente Firma/Distribución)''']
  "DISTRIBUIDA" [note: '''Distribuida''']
  "RESPONDIDA" [note: '''Respondida''']
  "ANULADA" [note: '''Anulada''']
}

enum correspondencia.char_comunicacioninterna_tipo_distribucion {
  "USUARIO" [note: '''Usuario Específico''']
  "OFICINA" [note: '''Oficina Completa (Subproceso)''']
  "PROCESO" [note: '''Proceso Completo''']
  "ENTIDAD" [note: '''Toda la Entidad''']
}

enum correspondencia.char_comunicacioninternadestinatario_tipo {
  "USUARIO" [note: '''Usuario''']
  "OFICINA" [note: '''Oficina''']
}

enum correspondencia.char_historialcomunicacioninterna_evento {
  "CREADA" [note: '''Comunicación Creada''']
  "EDITADA" [note: '''Comunicación Editada''']
  "ENVIADA_APROBACION" [note: '''Enviada a Aprobación''']
  "APROBADA" [note: '''Aprobada por Líder''']
  "RECHAZADA" [note: '''Rechazada por Líder''']
  "FIRMA_SUBIDA" [note: '''Firma Digital Subida''']
  "DISTRIBUIDA" [note: '''Distribuida a Destinatarios''']
  "LEIDA" [note: '''Leída por Usuario''']
  "RESPUESTA_CREADA" [note: '''Respuesta Creada''']
  "ANULADA" [note: '''Comunicación Anulada''']
}

